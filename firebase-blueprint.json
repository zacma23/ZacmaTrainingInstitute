{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Staff or administrator identity record without PII",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "displayName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "role": {
          "type": "string",
          "enum": ["admin", "accountant", "staff"]
        },
        "isActive": {
          "type": "boolean"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["uid", "displayName", "role", "isActive", "createdAt", "updatedAt"]
    },
    "UserPrivateInfo": {
      "title": "UserPrivateInfo",
      "description": "Isolated PII record (email and phone) for a user",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "email": {
          "type": "string",
          "format": "email",
          "maxLength": 180
        },
        "phone": {
          "type": "string",
          "maxLength": 30
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["uid", "email", "phone", "updatedAt"]
    },
    "UserWorkspacePref": {
      "title": "UserWorkspacePref",
      "description": "Per-user workspace preferences and operational notes persisted in Firestore",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "defaultLandingPage": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "compactTables": {
          "type": "boolean"
        },
        "preferredPaymentMethod": {
          "type": "string",
          "enum": ["Cash", "Bank Transfer", "Mobile Money"]
        },
        "savedNote": {
          "type": "string",
          "maxLength": 500
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["uid", "defaultLandingPage", "compactTables", "preferredPaymentMethod", "savedNote", "updatedAt"]
    },
    "AdminRegistry": {
      "title": "AdminRegistry",
      "description": "Authoritative RBAC administrator registry",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "email": {
          "type": "string",
          "format": "email",
          "maxLength": 180
        },
        "grantedBy": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["uid", "email", "grantedBy", "createdAt"]
    },
    "CourseRecord": {
      "title": "CourseRecord",
      "description": "Training course catalog record mirrored to Firestore",
      "type": "object",
      "properties": {
        "courseId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "ownerUid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "code": {
          "type": "string",
          "minLength": 2,
          "maxLength": 32
        },
        "name": {
          "type": "string",
          "minLength": 2,
          "maxLength": 140
        },
        "category": {
          "type": "string",
          "maxLength": 100
        },
        "durationValue": {
          "type": "number"
        },
        "durationUnit": {
          "type": "string",
          "enum": ["weeks", "months"]
        },
        "registrationFee": {
          "type": "number"
        },
        "defaultFee": {
          "type": "number"
        },
        "status": {
          "type": "string",
          "enum": ["Active", "Archived"]
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "courseId",
        "ownerUid",
        "code",
        "name",
        "category",
        "durationValue",
        "durationUnit",
        "registrationFee",
        "defaultFee",
        "status",
        "createdAt",
        "updatedAt"
      ]
    },
    "StudentRecord": {
      "title": "StudentRecord",
      "description": "Enrolled student record with balance summary",
      "type": "object",
      "properties": {
        "studentId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "ownerUid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "studentCode": {
          "type": "string",
          "minLength": 2,
          "maxLength": 40
        },
        "fullName": {
          "type": "string",
          "minLength": 2,
          "maxLength": 140
        },
        "phone": {
          "type": "string",
          "maxLength": 30
        },
        "email": {
          "type": "string",
          "maxLength": 180
        },
        "courseName": {
          "type": "string",
          "maxLength": 140
        },
        "status": {
          "type": "string",
          "enum": ["Active", "Graduated", "Suspended", "Inactive"]
        },
        "totalCourseFee": {
          "type": "number"
        },
        "totalPaid": {
          "type": "number"
        },
        "balance": {
          "type": "number"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "studentId",
        "ownerUid",
        "studentCode",
        "fullName",
        "phone",
        "email",
        "courseName",
        "status",
        "totalCourseFee",
        "totalPaid",
        "balance",
        "createdAt",
        "updatedAt"
      ]
    },
    "RegistrationApplication": {
      "title": "RegistrationApplication",
      "description": "Accountant-submitted student registration awaiting admin approval",
      "type": "object",
      "properties": {
        "applicationId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "submittedByUid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "studentName": {
          "type": "string",
          "minLength": 2,
          "maxLength": 140
        },
        "phone": {
          "type": "string",
          "maxLength": 30
        },
        "courseName": {
          "type": "string",
          "maxLength": 140
        },
        "paymentPlan": {
          "type": "string",
          "maxLength": 40
        },
        "status": {
          "type": "string",
          "enum": ["PENDING_ADMIN_APPROVAL", "CORRECTION_REQUIRED", "APPROVED", "REJECTED"]
        },
        "reviewComment": {
          "type": "string",
          "maxLength": 500
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "applicationId",
        "submittedByUid",
        "studentName",
        "phone",
        "courseName",
        "paymentPlan",
        "status",
        "reviewComment",
        "createdAt",
        "updatedAt"
      ]
    },
    "PaymentSubmission": {
      "title": "PaymentSubmission",
      "description": "Accountant-collected fee payment awaiting admin approval",
      "type": "object",
      "properties": {
        "submissionId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "submittedByUid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "studentCode": {
          "type": "string",
          "maxLength": 40
        },
        "studentName": {
          "type": "string",
          "maxLength": 140
        },
        "amount": {
          "type": "number"
        },
        "paymentMethod": {
          "type": "string",
          "enum": ["Cash", "Bank Transfer", "Mobile Money"]
        },
        "referenceNo": {
          "type": "string",
          "maxLength": 120
        },
        "status": {
          "type": "string",
          "enum": ["PENDING", "APPROVED", "REJECTED"]
        },
        "reviewComment": {
          "type": "string",
          "maxLength": 500
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "submissionId",
        "submittedByUid",
        "studentCode",
        "studentName",
        "amount",
        "paymentMethod",
        "referenceNo",
        "status",
        "reviewComment",
        "createdAt",
        "updatedAt"
      ]
    },
    "NotificationRecord": {
      "title": "NotificationRecord",
      "description": "Due date, approval, or rejection notification persisted per target user",
      "type": "object",
      "properties": {
        "notificationId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "ownerUid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "targetUid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "type": {
          "type": "string",
          "maxLength": 50
        },
        "title": {
          "type": "string",
          "maxLength": 160
        },
        "message": {
          "type": "string",
          "maxLength": 500
        },
        "isRead": {
          "type": "boolean"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "notificationId",
        "ownerUid",
        "targetUid",
        "type",
        "title",
        "message",
        "isRead",
        "createdAt",
        "updatedAt"
      ]
    },
    "AuditLogRecord": {
      "title": "AuditLogRecord",
      "description": "Immutable compliance audit trail entry",
      "type": "object",
      "properties": {
        "logId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "actorUid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "action": {
          "type": "string",
          "maxLength": 80
        },
        "entityType": {
          "type": "string",
          "maxLength": 60
        },
        "entityId": {
          "type": "string",
          "maxLength": 128
        },
        "summary": {
          "type": "string",
          "maxLength": 500
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["logId", "actorUid", "action", "entityType", "entityId", "summary", "createdAt"]
    },
    "ChatMessage": {
      "title": "ChatMessage",
      "description": "Multi-turn AI assistant conversation turn persisted per user",
      "type": "object",
      "properties": {
        "msgId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "role": {
          "type": "string",
          "enum": ["user", "model"]
        },
        "assistantRoleId": {
          "type": "string",
          "maxLength": 40
        },
        "content": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        },
        "modelUsed": {
          "type": "string",
          "maxLength": 64
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["msgId", "uid", "role", "assistantRoleId", "content", "modelUsed", "createdAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "Non-PII staff and admin profile records"
    },
    "/users/{userId}/private/{docId}": {
      "schema": { "$ref": "#/entities/UserPrivateInfo" },
      "description": "Isolated PII (email, phone) strictly accessible by owner or admin"
    },
    "/users/{userId}/preferences/{prefId}": {
      "schema": { "$ref": "#/entities/UserWorkspacePref" },
      "description": "User workspace preferences and saved accountant/admin notes"
    },
    "/admins/{adminId}": {
      "schema": { "$ref": "#/entities/AdminRegistry" },
      "description": "Trusted administrator RBAC registry"
    },
    "/courses/{courseId}": {
      "schema": { "$ref": "#/entities/CourseRecord" },
      "description": "Institute course catalog mirrored in Firestore"
    },
    "/students/{studentId}": {
      "schema": { "$ref": "#/entities/StudentRecord" },
      "description": "Student fee & enrollment directory mirrored in Firestore"
    },
    "/registration_applications/{applicationId}": {
      "schema": { "$ref": "#/entities/RegistrationApplication" },
      "description": "Student registration intake submissions awaiting admin approval"
    },
    "/payment_submissions/{submissionId}": {
      "schema": { "$ref": "#/entities/PaymentSubmission" },
      "description": "Payment intake submissions awaiting admin verification"
    },
    "/notifications/{notificationId}": {
      "schema": { "$ref": "#/entities/NotificationRecord" },
      "description": "Staff and admin workflow notifications"
    },
    "/audit_logs/{logId}": {
      "schema": { "$ref": "#/entities/AuditLogRecord" },
      "description": "Immutable security and financial audit log"
    },
    "/users/{userId}/chat_messages/{msgId}": {
      "schema": { "$ref": "#/entities/ChatMessage" },
      "description": "Multi-turn Gemini assistant chat history scoped strictly to the owning user"
    }
  }
}
