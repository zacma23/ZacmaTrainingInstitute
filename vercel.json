{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "buildCommand": "npm run build",
  "outputDirectory": "public",
  "functions": {
    "api/index.js": {
      "maxDuration": 30,
      "includeFiles": "{server.js,config/**,middleware/**,routes/**,services/**,sql/**,utils/**,firebase-applet-config.json}"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/((?!api/|assets/|js/|vendor/|styles\\.css|app\\.js|favicon\\.ico).*)",
      "destination": "/index.html"
    }
  ]
}
