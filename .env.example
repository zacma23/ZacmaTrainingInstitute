# Server Configuration
PORT=3000
NODE_ENV=development
TZ=Africa/Addis_Ababa

# MySQL Database Configuration
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=your_mysql_user
DB_PASSWORD=your_mysql_password
DB_NAME=sfmt_ethiopia
DB_CONNECTION_LIMIT=10

# Authentication & Security
JWT_SECRET=replace_with_64_char_random_hex_secret
JWT_EXPIRES_IN=12h
BCRYPT_ROUNDS=10

# Initial Administrator & Accountant Bootstrap (Optional — if omitted, use First-Time Setup UI)
ADMIN_INIT_USERNAME=
ADMIN_INIT_PASSWORD=
ADMIN_INIT_FULLNAME=Institute Administrator
ACCOUNTANT_INIT_USERNAME=
ACCOUNTANT_INIT_PASSWORD=
ACCOUNTANT_INIT_FULLNAME=Institute Accountant

# WhatsApp / SMS Gateway Integration (Optional — Leave blank if not configured)
WHATSAPP_PROVIDER=none
WHATSAPP_API_URL=
WHATSAPP_API_TOKEN=
SMS_PROVIDER=none
SMS_API_URL=
SMS_API_KEY=
SMS_SENDER_ID=

# AI Studio Runtime Variables (Auto-injected in AI Studio)
GEMINI_API_KEY="MY_GEMINI_API_KEY"
APP_URL="MY_APP_URL"
