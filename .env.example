# Server Configuration
PORT=3000
NODE_ENV=development
TZ=Africa/Addis_Ababa

# MySQL Database Configuration (Option 1: Connection URL for TiDB Cloud / Aiven / Railway / PlanetScale)
# Example: mysql://user:password@host:4000/sfmt_ethiopia?ssl-mode=REQUIRED
DATABASE_URL=

# MySQL Database Configuration (Option 2: Individual Parameters)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=your_mysql_user
DB_PASSWORD=your_mysql_password
DB_NAME=sfmt_ethiopia
DB_CONNECTION_LIMIT=10
# Set DB_SSL=true (or skip-verify) for cloud MySQL providers requiring TLS
DB_SSL=
# Optional Base64 or PEM CA certificate for strict TLS cloud MySQL verification
DB_SSL_CA=
# Optional: set to true after initial schema creation for faster serverless cold starts
DB_SKIP_SCHEMA_SYNC=false

# Authentication & Security
JWT_SECRET=replace_with_64_char_random_hex_secret
JWT_EXPIRES_IN=12h
BCRYPT_ROUNDS=10

# Initial Administrator & Accountant Bootstrap (Optional — if omitted, use First-Time Setup UI)
ADMIN_INIT_USERNAME=
ADMIN_INIT_PASSWORD=
ADMIN_INIT_FULLNAME=Institute Administrator
ACCOUNTANT_INIT_USERNAME=
ACCOUNTANT_INIT_PASSWORD=
ACCOUNTANT_INIT_FULLNAME=Institute Accountant

# Firebase Admin (Optional JSON or Base64 service account for Vercel/external hosting)
FIREBASE_SERVICE_ACCOUNT_JSON=

# Optional secret to protect /api/cron/reminders (Vercel Cron)
CRON_SECRET=

# WhatsApp / Phone Number SMS Gateway Integration (Optional — Leave blank if not configured)
WHATSAPP_PROVIDER=none
WHATSAPP_API_URL=
WHATSAPP_API_TOKEN=
# SMS_PROVIDER: none | twilio | africastalking | afromessage | custom
SMS_PROVIDER=none
SMS_FROM_NUMBER=
SMS_SENDER_ID=ZacmaTech
SMS_API_URL=
SMS_API_KEY=
# Twilio credentials (when SMS_PROVIDER=twilio)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
# Africa's Talking credentials (when SMS_PROVIDER=africastalking)
AFRICASTALKING_USERNAME=
AFRICASTALKING_API_KEY=
# AfroMessage identifier (when SMS_PROVIDER=afromessage)
AFROMESSAGE_TOKEN=
AFROMESSAGE_IDENTIFIER_ID=

# Email Provider Integration (Optional — SMTP via Nodemailer or Resend HTTP API)
SMTP_URL=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=
EMAIL_FROM_NAME=Zacma Technology Institute
RESEND_API_KEY=

# Gemini AI Assistant (Required for Operations & Fee Assistant chatbot)
GEMINI_API_KEY=
APP_URL=

